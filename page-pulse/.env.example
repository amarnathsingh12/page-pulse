PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true
TRUST_PROXY_HOPS=1

REDIS_URL=redis://localhost:6379
REDIS_COMMAND_TIMEOUT_MS=200

CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
NEG_CACHE_TTL_SECONDS=30
CACHE_MAX_VALUE_BYTES=262144

FETCH_CONNECT_TIMEOUT_MS=3000
FETCH_HEADERS_TIMEOUT_MS=5000
FETCH_BODY_TIMEOUT_MS=8000
FETCH_TOTAL_DEADLINE_MS=10000
MAX_RESPONSE_BYTES=2097152
MAX_DECOMPRESSED_BYTES=8388608
MAX_PARSE_BYTES=1048576
MAX_REDIRECTS=5
USER_AGENT=PagePulse/1.0 (+https://digitalheroesco.com)

MAX_URL_LENGTH=2048
BODY_LIMIT_BYTES=16384
REQUEST_TIMEOUT_MS=12000
ALLOWED_SCHEMES=http,https
ALLOWED_PORTS=80,443

ALLOW_PRIVATE_IPS=false

GLOBAL_MAX_CONCURRENCY=50
PER_HOST_CONCURRENCY=4
PER_CLIENT_CONCURRENCY=5
CONCURRENCY_QUEUE_MAX_DEPTH=100
CONCURRENCY_QUEUE_TIMEOUT_MS=2000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_MODE=open
